# Application
APP_ENV=development
APP_NAME=AgriFusionNet
PUBLIC_ORIGIN=https://sf.projectdunia.my.id
BACKEND_ORIGIN=http://localhost:8000
ALLOW_FARMER_SELF_REGISTRATION=true

# Database
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=agrifusionnet
MYSQL_USER=agrifusion
MYSQL_PASSWORD=change-me-db
DATABASE_URL=mysql+pymysql://agrifusion:change-me-db@127.0.0.1:3307/agrifusionnet?charset=utf8mb4

# Superadmin bootstrap (Compose secrets in production)
SUPERADMIN_EMAIL=superadmin@gmail.com
SUPERADMIN_PASSWORD=password
SUPERADMIN_NAME=Super Admin

# Seeded demo farmer (created by app.cli seed-demo)
DEMO_FARMER_EMAIL=petani@gmail.com
DEMO_FARMER_PASSWORD=password

# Isolated Playwright farmer (not the demo presentation account)
E2E_FARMER_EMAIL=e2e.farmer@agrifusion.test
E2E_FARMER_PASSWORD=E2eFarmer123!

# Session and security
SESSION_COOKIE_NAME=agrifusion_session
SESSION_TTL_HOURS=24
CSRF_HEADER_NAME=X-CSRF-Token
TRUSTED_PROXY_IPS=127.0.0.1

# Retention (days unless noted)
AUDIT_LOG_RETENTION_DAYS=365
SAVED_IMAGE_RETENTION_DAYS=180
PREDICTION_RETENTION_DAYS=730
ANONYMIZED_HARD_DELETE_DAYS=90
HSTS_MAX_AGE=31536000

# SoilGrids local cache (demo JSON) and live REST cache
SOILGRIDS_CACHE_DIR=/data/soilgrids
SOILGRIDS_LIVE_CACHE_DIR=/data/adapter-cache/soilgrids-live
SOILGRIDS_DEMO_REGION=central-java
SOILGRIDS_LIVE_ENABLED=true
SOILGRIDS_TIMEOUT_SECONDS=8
SOILGRIDS_RETRIES=2

# NASA POWER daily point adapter
NASA_POWER_ENABLED=true
NASA_POWER_TIMEOUT_SECONDS=8
NASA_POWER_RETRIES=2
NASA_POWER_CACHE_DIR=/data/adapter-cache/nasa-power
NASA_POWER_CACHE_TTL_HOURS=24

# Model paths
DISEASE_MODEL_PATH=/models/disease_v1.onnx
DISEASE_MODEL_VERSION=disease-mobilenet-v1-paddy-doctor
DISEASE_CONFIDENCE_THRESHOLD=0.52

# Mapping
MAPPING_FIXTURE_PATH=/fixtures/mapping/demo_raster.tif

# Set true only when the site is served exclusively over HTTPS (not http://127.0.0.1:8005).
COOKIE_SECURE_ENABLED=false

# Auth throttling (per IP, sliding window). Keep high enough for classroom/e2e, low enough to slow brute force.
LOGIN_RATE_LIMIT=120
REGISTER_RATE_LIMIT=20
PASSWORD_RATE_LIMIT=10
UPLOAD_RATE_LIMIT=40
RATE_LIMIT_WINDOW_SECONDS=60

# Cloudflare (optional, Phase 6)
# CLOUDFLARE_TUNNEL_TOKEN=
